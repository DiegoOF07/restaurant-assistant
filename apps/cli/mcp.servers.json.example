{
  "servers": [
    {
      "name": "restaurant-local",
      "description": "Servidor MCP de recetas e inventario (Go), lanzado como subproceso por stdio.",
      "command": "../../../restaurant-mcp-server/bin/restaurant-mcp-server",
      "args": [],
      "env": {}
    },

    {
      "name": "restaurant-remoto",
      "description": "El mismo servidor, pero ya corriendo en otra máquina. El rol lo decide el token, no el cliente.",
      "enabled": false,
      "url": "https://mi-servidor.ejemplo.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_REMOTE_TOKEN}"
      }
    },

    {
      "name": "companero-binario",
      "description": "MCP de un compañero que te pasó el binario. Copialo en servers/ (ver servers/README.md).",
      "enabled": false,
      "command": "./servers/companero-mcp-server",
      "env": {
        "API_TOKEN": "${TOKEN_DEL_COMPANERO}"
      }
    },

    {
      "name": "companero-remoto",
      "description": "MCP de un compañero que ya lo tiene desplegado. Acá no se copia nada.",
      "enabled": false,
      "url": "http://192.168.1.50:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${TOKEN_DEL_COMPANERO}"
      }
    },

    {
      "name": "finanzas-pyme",
      "description": "MCP de un compañero (Python, stdio): finanzas de una PYME. Requiere `pip install -e .` en su venv; FINANZAS_PYTHON apunta al python de ESE venv (ver .env.example).",
      "enabled": false,
      "command": "${FINANZAS_PYTHON}",
      "args": ["-m", "finanzas_mcp.server"],
      "env": {}
    },

    {
      "name": "design-system",
      "description": "MCP de un compañero (Python, stdio): tokens de Design System, consistencia y contraste WCAG. Se lanza por script, así que la ruta del repo va en DESIGN_SYSTEM_HOME.",
      "enabled": false,
      "command": "${DESIGN_SYSTEM_PYTHON}",
      "args": ["${DESIGN_SYSTEM_HOME}/app/server.py"],
      "env": {}
    },

    {
      "name": "filesystem",
      "description": "Filesystem MCP server oficial. Requiere Node y acceso a red la primera vez. Sólo puede tocar los directorios que recibe como argumento: apúntalo a un sandbox, no al proyecto.",
      "enabled": false,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${SANDBOX_DIR}"]
    },

    {
      "name": "git",
      "description": "Git MCP server oficial. Requiere uv/uvx instalado. Trabaja sobre un repositorio local: status, diff, add, commit, ramas. No hace push.",
      "enabled": false,
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${SANDBOX_DIR}"]
    }
  ]
}
