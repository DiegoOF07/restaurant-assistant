# Ruta al binario compilado del servidor MCP.
# Se resuelve respecto a la carpeta apps/cli/ (no al directorio donde ejecutas el comando).
# Linux / macOS / WSL:
MCP_SERVER_BIN=../../../restaurant-mcp-server/bin/restaurant-mcp-server
# Windows (PowerShell) el binario DEBE terminar en .exe:
# MCP_SERVER_BIN=../../../restaurant-mcp-server/bin/restaurant-mcp-server.exe

# Opcionales
# MCP_SERVER_ARGS=
# HOST_MAX_ITERATIONS=8

# --- Proveedor LLM ---
# Sin esta variable el CLI usa el proveedor de demostración (sin costo ni conexión).
# ANTHROPIC_API_KEY=sk-ant-...
# Opcional: sobreescribe el modelo por defecto (claude-opus-5).
# Los IDs llevan guiones, no puntos ("claude-haiku-4-5", NO "claude-haiku-4.5");
# un ID mal escrito da un 404 not_found_error al enviar el primer mensaje.
# Válidos: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5

# --- Identidad y permisos ---
# El SERVIDOR valida el rol; el CLI solo lo transporta.
# Roles válidos: waiter (solo lectura) | cook | admin
# Sin definir, el servidor aplica "waiter" y deniega adjust_inventory.
MCP_USER_ROLE=admin
MCP_USER_ID=diego
