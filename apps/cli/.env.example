# Copia este archivo a .env y ajusta lo que necesites.
# Todas las rutas relativas se resuelven respecto a apps/cli/, no al directorio
# donde ejecutas el comando.

# --- Servidores MCP ---
# La lista de servidores vive en apps/cli/mcp.servers.json (copia
# mcp.servers.json.example). Estas variables sólo cambian de dónde se lee.
#
# Usar otro archivo de configuración:
# MCP_CONFIG_FILE=./mi-configuracion.json
#
# Compatibilidad: si NO existe mcp.servers.json, el CLI lanza un único servidor
# tomado de estas dos variables.
# MCP_SERVER_BIN=../../../restaurant-mcp-server/bin/restaurant-mcp-server
# MCP_SERVER_ARGS=

# Máximo de vueltas del ciclo tool-calling en un turno, antes de rendirse.
# HOST_MAX_ITERATIONS=8

# --- Servidores MCP de terceros ---
# Cuando una entrada de mcp.servers.json usa ${VARIABLE}, el valor sale de aquí.
# Estas van con ruta ABSOLUTA: sólo "command" se resuelve contra el archivo de
# configuración; los "args" no, así que una ruta relativa dentro de args dependería
# del directorio desde el que arrancas el CLI.
# Usa "/" incluso en Windows (Node y Python lo aceptan) y apunta al intérprete DEL
# VENV: el CLI no hereda el entorno virtual que tengas activo en la shell.
#
# MCP de finanzas para PYMES (pip install -e . dentro de ese venv):
#   Windows: .../.venv/Scripts/python.exe    Linux/macOS/WSL: .../.venv/bin/python
# FINANZAS_PYTHON=C:/ruta/a/mcp-finanzas-pyme/.venv/bin/python.exe
# Opcional: dónde crear el SQLite (por defecto data/finanzas.db junto al paquete).
# FINANZAS_DB_PATH=C:/ruta/a/finanzas.db
#
# MCP de Design System (se lanza por script, así que también hace falta su raíz):
# DESIGN_SYSTEM_HOME=C:/ruta/a/mcp-design-system-server
# DESIGN_SYSTEM_PYTHON=C:/ruta/a/mcp-design-system-server/venv/bin/python.exe

# --- Filesystem y Git MCP server (oficiales) ---
# Directorio que ambos exponen. El Filesystem server sólo puede leer y escribir dentro
# de las rutas que recibe como argumento, y el Git server opera sobre ese repositorio;
# conviene que sea un repo desechable y no el proyecto real.
# Crearlo es: mkdir mcp-sandbox && cd mcp-sandbox && git init
# SANDBOX_DIR=C:/ruta/a/mcp-sandbox
#
# `npx` y `uvx` se resuelven por PATH: hace falta Node (ya lo tienes) y uv para el de Git
# (https://docs.astral.sh/uv/). La primera ejecución de cada uno descarga el paquete.

# --- Servidor remoto propio ---
# Token para la entrada "restaurant-remoto".
# MCP_REMOTE_TOKEN=

# --- Proveedor LLM ---
# Sin esta variable el CLI usa el proveedor de demostración (sin costo ni conexión),
# que basta para probar el protocolo MCP de punta a punta.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Opcional: sobreescribe el modelo por defecto.
# Los IDs llevan guiones, no puntos ("claude-haiku-4-5", NO "claude-haiku-4.5");
# un ID mal escrito da un 404 not_found_error al enviar el primer mensaje.
# Válidos: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Identidad y permisos ---
# El SERVIDOR valida el rol; el CLI sólo lo transporta. Un rol desconocido NO
# escala privilegios: el servidor lo degrada a waiter y lo anota en stderr.
# Roles: waiter (solo lectura) | cook | admin
# MCP_USER_ROLE=cook
# MCP_USER_ID=diego

# --- Apariencia ---
# NO_COLOR=1        desactiva el color
# FORCE_COLOR=1     fuerza el color aunque la salida no sea una terminal
