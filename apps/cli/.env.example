# Ruta al binario compilado del servidor MCP.
# Se resuelve respecto a la carpeta apps/cli/ (no al directorio donde ejecutas el comando).
# Linux / macOS / WSL:
MCP_SERVER_BIN=../../../restaurant-mcp-server/bin/restaurant-mcp-server
# Windows (PowerShell) — el binario DEBE terminar en .exe:
# MCP_SERVER_BIN=../../../restaurant-mcp-server/bin/restaurant-mcp-server.exe

# Opcionales
# MCP_SERVER_ARGS=
# HOST_MAX_ITERATIONS=8
